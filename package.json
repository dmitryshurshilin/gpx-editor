{
  "name": "gpx-editor",
  "version": "2.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "format": "prettier --write src tests index.html *.json *.js *.md",
    "format:check": "prettier --check src tests index.html *.json *.js *.md"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "@xmldom/xmldom": "0.9.12"
  },
  "releaseDate": "2026-10-29"
}
